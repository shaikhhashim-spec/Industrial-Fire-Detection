# NASA FIRMS API key — free, register at https://firms.modaps.eosdis.nasa.gov/api/area/
# Arrives by email within a few minutes. Never commit your real key — this
# file is a template; your actual key goes in a local .env (gitignored).
FIRMS_API_KEY=

# Accepted as a fallback alias for FIRMS_API_KEY, for backward compatibility.
FIRMS_MAP_KEY=

# --- Critical Alert SMS & Message Dispatch (Optional) -------------------------
# Recipient phone number for critical alert messages. Required before anything
# can be dispatched; there is no built-in default.
ALERT_RECIPIENT_PHONE=

# Automatically dispatch notifications when alerts reach CRITICAL severity (true / false)
ALERT_AUTO_DISPATCH_CRITICAL=true

# Twilio SMS API Gateway Credentials:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_SMS_TO_NUMBER=

# Voice escalation: a dispatched critical alert nobody acknowledges within
# ALERT_ESCALATE_AFTER_MIN minutes can be escalated to a phone call from the
# Alerts page. Leave ALERT_AUTO_ESCALATE_CALL false to keep the call behind an
# explicit click. Twilio voice needs a voice-capable sender; it falls back to
# TWILIO_FROM_NUMBER. With no credentials the call is simulated and logged.
ALERT_ESCALATE_AFTER_MIN=15
ALERT_AUTO_ESCALATE_CALL=false
TWILIO_VOICE_FROM_NUMBER=

# Telegram Bot API (optional channel):
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Generic Alert Webhook (optional channel):
ALERT_WEBHOOK_URL=

# Cloud launcher only; start_all.py retains local startup defaults.
# Render supplies PORT. Free demo permits ephemeral SQLite, no background worker.
CLOUD_MODE=false
THERMAL_DEMO_MODE=false
PORT=10000
# Production requires PostgreSQL; leave blank for local/free demo SQLite.
DATABASE_URL=
THERMAL_ADMIN_USERNAME=admin
THERMAL_ADMIN_PASSWORD=
# Blank uses local paths; omit in cloud to use container defaults.
THERMAL_DATA_DIR=
THERMAL_OUTPUT_DIR=
# Optional SQLite file override; cloud default is THERMAL_DATA_DIR/server.db.
THERMAL_SERVER_DB=
# Optional paid worker/scheduler only; leave disabled for the free demonstration.
THERMAL_REFRESH_PROVIDER=
THERMAL_SCHEDULER_ENABLED=0
JOBS_ENABLED=false
# Cloud launcher sets these asset locations and public relative URL:
# GLOBE_URL=/globe
# GATEWAY_SITE_DIR=/app/_site
# GATEWAY_GLOBE_DIR=/app/_site/globe
# GATEWAY_GLOBE_DATA_DIR=/app/_site/globe/data
