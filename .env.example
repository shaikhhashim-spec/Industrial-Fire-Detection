# NASA FIRMS API key — free, register at https://firms.modaps.eosdis.nasa.gov/api/area/
# Arrives by email within a few minutes. Never commit your real key — this
# file is a template; your actual key goes in a local .env (gitignored).
FIRMS_API_KEY=

# Accepted as a fallback alias for FIRMS_API_KEY, for backward compatibility.
FIRMS_MAP_KEY=

# --- WhatsApp Alert Integration (Optional) -----------------------------------
# Target phone recipient (defaults to 9967541336)
WHATSAPP_RECIPIENT_PHONE=9967541336
# Risk score threshold to trigger high-risk WhatsApp alert (defaults to 85.0)
WHATSAPP_RISK_THRESHOLD=85.0
# Automatic dispatch on pipeline runs (true / false)
WHATSAPP_ENABLED=true
# Gateway provider: auto / simulated / twilio / callmebot / meta / webhook
WHATSAPP_PROVIDER=auto

# Optional Gateway Credentials:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=+14155238886

# CallMeBot API key (free personal WhatsApp gateway):
CALLMEBOT_API_KEY=

# Meta WhatsApp Cloud API:
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Custom Webhook Endpoint URL:
WHATSAPP_WEBHOOK_URL=

